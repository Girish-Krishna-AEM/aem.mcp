# Copy this file to .env and adjust values as needed.
# .env is gitignored — no secrets exist in Phase 1, but this keeps the
# environment-variable pattern consistent for when Phase 2 introduces them.

# Shared logging level for both services (TRACE|DEBUG|INFO|WARN|ERROR|CRITICAL|NONE)
LOG_LEVEL=INFO

# Lightning MCP Server (Unit 1) — overridden per-service in docker-compose.yml;
# listed here for reference / for running services outside Compose.
LISTEN_PORT_MCP=8000

# Coordinator Agent (Unit 2)
LISTEN_PORT_COORDINATOR=8001

# Lightning MCP Server base URL as seen by the Coordinator Agent.
# Docker Compose (local or EC2): resolves via Compose service-name DNS — do not change.
# Running CoordinatorAgent standalone outside Compose: use http://localhost:8000 instead.
MCP_SERVER_URL=http://lightning-mcp-server:8000

# External lightning pulse API (used by Unit 1's StrikeDetectionModule).
# Defaults to the QA endpoint if not set; override for other environments.
LIGHTNING_PULSE_API_BASE_URL=https://qa.lxneartime.api.enqa.co
# Required — no default. Set your real API key here in your local .env (never commit it).
LIGHTNING_PULSE_API_KEY=

# US Census Geocoder (used by Unit 2's LocationGeocoder, FR-4) — primary provider, best for
# full street addresses. All optional — defaults below are used if unset; free, no API key required.
CENSUS_GEOCODER_BASE_URL=https://geocoding.geo.census.gov/geocoder/
CENSUS_GEOCODER_TIMEOUT_SECONDS=10

# Nominatim / OpenStreetMap (used by Unit 2's LocationGeocoder, FR-4) — fallback provider, used
# only when Census Geocoder finds no match (e.g. City+State or bare ZIP input). All optional —
# defaults below are used if unset; free, no API key required. Usage policy requires a descriptive
# User-Agent — update NOMINATIM_USER_AGENT if deploying this under a different project/org name.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org/
NOMINATIM_TIMEOUT_SECONDS=10
NOMINATIM_USER_AGENT=LightningDetectionCoordinatorAgent/1.0 (POC)
